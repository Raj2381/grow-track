# Browser-safe values (these two are meant to be public)
NEXT_PUBLIC_SUPABASE_URL=https://wiorhasdvnpkeztjzech.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_4UPNdP9Klkb3C9krfsq2dw_9hnyOfjY

# SERVER ONLY. Never prefix with NEXT_PUBLIC_, never commit. Needed for seeding and migrations.
# Get them from the Supabase dashboard: Project Settings -> API (service_role) and Database -> Connection string.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL= 

# Optional, SERVER ONLY: enables AI-written mock interview questions and feedback (/mock-interviews).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Built-in demo sign-in (there is no login page). Throwaway accounts created by `npx tsx scripts/db/e2e-accounts.ts create`.
# These are NEXT_PUBLIC_ on purpose: they are in the browser bundle, so use test accounts only, never real credentials.
NEXT_PUBLIC_DEMO_PASSWORD=
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=
NEXT_PUBLIC_DEMO_FACULTY_EMAIL=
NEXT_PUBLIC_DEMO_HOD_EMAIL=
NEXT_PUBLIC_DEMO_TPO_EMAIL=
NEXT_PUBLIC_DEMO_STUDENT_EMAIL=

# Optional: true makes the proxy enforce the role routing rules (off by default)
NEXT_PUBLIC_REQUIRE_AUTH=false
