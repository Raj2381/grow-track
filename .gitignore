# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Round 2 pipeline: models and intermediates are rebuilt by `npm run ml:all`
/ml/out/*
!/ml/out/features.csv
!/ml/out/cleaning_report.json
!/ml/out/feature_columns.json
!/ml/out/whatif_parity.json
__pycache__/

# keep the template of required variable names
!.env.example

# demo logins written by `npm run db:users` (random passwords, never commit)
.demo-credentials.local

# editor / assistant settings
/.vscode/
/.claude/

# generated executive brief
/data/brief/
